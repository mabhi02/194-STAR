<div class="body-wrapper">

    <div class="sql-component">
        <h2>SQL Query Builder</h2>

        <div class="query-section">
            <p><strong>Complete the SQL Query:</strong></p>
            <code id="query-prefix">SELECT * FROM employees WHERE</code>
            <textarea id="sql-input" placeholder="Enter the condition (e.g., salary > 60000)"></textarea>
            <div class="selection-button" id="run-query">Run Query</div>
        </div>

        <div class="table-section">
            <p><strong>Query Results:</strong></p>
            <div id="output-table"></div>
        </div>

        <div class="feedback-section">
            <p id="feedback"></p>
        </div>
    </div>

</div>